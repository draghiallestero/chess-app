{
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Run UI",
            "cargo": {
                "args": [
                    "build"
                ],
                "cwd": "${workspaceFolder}/ui"
            },
            "args": [],
            "preLaunchTask": "Build UI"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Run UI Release",
            "cargo": {
                "args": [
                    "build",
                    "--release"
                ],
                "cwd": "${workspaceFolder}/ui"
            },
            "args": [],
            "preLaunchTask": "Build UI Release"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Run Tests",
            "cargo": {
                "args": [
                    "test"
                ],
                "cwd": "${workspaceFolder}/backend"
            },
            "args": [],
            "preLaunchTask": "Build Tests"
        }
    ]
}